# -----------------------------------------------------------------------------
# Environment variables — the SECRET values, shared by every client.
#
# These are NOT committed to the repo. On Netlify you paste them into
#   Site settings → Environment variables.
# For local testing with the Netlify CLI, copy this file to ".env".
#
# All clients share ONE Metricool account and ONE Notion integration, so there
# are only three secrets total — no per-client keys.
# -----------------------------------------------------------------------------

# Metricool — from your Metricool account (Settings → API/Connections).
METRICOOL_TOKEN=your-metricool-user-token
METRICOOL_USER_ID=3383962

# Notion — the internal integration secret (starts with "ntn_" or "secret_").
# The integration must be connected to each client's hub page in Notion.
NOTION_TOKEN=your-notion-integration-secret
